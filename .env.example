# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# This file lists variable names only - never put a real value here.

# --- Application ---

# Postgres connection string used by the app and by drizzle-kit migrations.
# Against the local compose stack this is built from the POSTGRES_* values below:
#   postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>
#
# postgres.js does not use TLS unless the URL asks for it. Pointing this at a
# remote or managed Postgres means appending `?sslmode=require` (or stricter).
DATABASE_URL=

# Required for /signup to work at all. Creating a *household* is gated on this
# shared secret, because v1 has no public signup (SPEC.md §2) but one deployment
# still serves many independent households. Joining an existing household does
# not use it - that goes through a single-use invite link instead.
#
# Unset or blank means signup is closed, not open: the check fails closed, so a
# fresh deployment accepts nothing until you pick a value. Generate a
# high-entropy one with `openssl rand -base64 32`. Any non-blank string is
# accepted, so `letmein` is a valid and terrible configuration.
HOUSEHOLD_SIGNUP_TOKEN=

# Optional. Forces the `Secure` flag on the session cookie when the app is
# served over plain HTTP behind a TLS-terminating reverse proxy - the app sees
# http even though the browser sees https, so NODE_ENV alone cannot tell. Set to
# the literal `true`.
#
# Leave unset for local development: a Secure cookie on http://localhost is
# dropped by the browser, which presents as login silently doing nothing. This
# also controls the `__Host-` prefix on the cookie name, so flipping it signs
# everyone out once.
SESSION_COOKIE_SECURE=

# --- docker-compose.yml `db` service ---

# Required. `docker compose up` refuses to start without it; there is no default,
# so that no deployment ever ends up running on a password from a public repo.
POSTGRES_PASSWORD=

# Optional, defaulted in docker-compose.yml (stockt / stockt / 5432).
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PORT=

# --- Tests ---

# Optional, and a loaded gun. The integration suite runs
# `TRUNCATE household ... CASCADE` against this database before every single
# test. Leave it unset and the suite starts its own throwaway Postgres from
# docker-compose.test.yml instead - that is the intended path.
#
# Never point this at a database you care about. As a backstop the suite refuses
# to run unless the database name ends in `_test`, but do not rely on that.
TEST_DATABASE_URL=
